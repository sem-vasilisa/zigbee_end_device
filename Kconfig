# Parametry aplikacji sterowane build-time (-DCONFIG_...=<wartosc>).
#
# Pola serii w board-power-test (zakladka Zigbee) odpowiadaja tym symbolom:
#
#   Send interval (T)    -> CONFIG_ZB_SEND_INTERVAL_S
#   Long-poll interval   -> CONFIG_ZB_POLL_INTERVAL_S
#
# Keepalive zostaje na stale w kodzie (60 s, main.c), wiec nie ma go tutaj.
#
# Wartosci domyslne = dzisiejsze zachowanie kodu, wiec build bez zadnej
# flagi daje ten sam obraz co dotad.

config ZB_SEND_INTERVAL_S
	int "Send interval T - co ile sekund wysylamy raport [s]"
	default 20
	range 1 4200
	help
	  Okres wysylania ZCL Report Attribute do koordynatora. To jest "T"
	  z modelu I_avg(T) = E_report/T + I_sleep.

	  Gorny limit 4200 s wynika z ZB_MILLISECONDS_TO_BEACON_INTERVAL:
	  makro mnozy ms x 1000 w 32-bitowym zb_time_t, wiec ok. 4294 s to
	  granica przepelnienia.

config ZB_POLL_INTERVAL_S
	int "Long-poll interval - co ile ED odpytuje rodzica [s]"
	default 3600
	range 1 4200
	help
	  macDataPollInterval: co tyle sekund radio budzi sie, zeby zapytac
	  rodzica o zalegle wiadomosci. Kazde takie wybudzenie kosztuje prad,
	  nawet gdy nie ma zadnych danych do odebrania.

config ZB_DEEP_SLEEP
	bool "Po wyslaniu raportu wejdz w System OFF (reboot co cykl)"
	default n
	select POWEROFF
	help
	  Domyslnie (n) urzadzenie spi w System ON: RAM i stos ZBOSS zyja,
	  miedzy raportami leci tylko poll. Wlaczone (y) - po wyslaniu raportu
	  uzbraja budzik GRTC na ZB_SEND_INTERVAL_S i wchodzi w System OFF.

	  Wybudzenie to PELNY RESET: RAM znika, main() startuje od zera, stos
	  ZBOSS wstaje na nowo i dolacza do sieci ponownie (sygnal
	  ZB_BDB_SIGNAL_DEVICE_REBOOT, klucze czytane z ZBOSS NVRAM).

	  Prad snu spada o rzad wielkosci, ale kazdy cykl placi za reboot
	  i ponowne dolaczenie. Przy krotkich T wychodzi DROZEJ niz System ON;
	  sens ma dopiero przy rzadkich raportach. Zeby znalezc punkt
	  przeciecia, zmierz oba warianty przy tych samych T.

	  UWAGA: sen musi byc krotszy niz ED aging timeout rodzica
	  (ED_AGING_TIMEOUT_256MIN = 15360 s), inaczej rodzic wyrzuci dziecko
	  i kazde wybudzenie bedzie pelnym dolaczaniem od zera, nie rebootem.

config ZB_DEEP_SLEEP_SETTLE_MS
	int "Ile czekac po wyslaniu raportu przed System OFF [ms]"
	default 1000
	range 50 10000
	depends on ZB_DEEP_SLEEP
	help
	  ZB_ZCL_SEND_COMMAND_* tylko KOLEJKUJE ramke - wyjscie na antene
	  dzieje sie pozniej, w watku ZBOSS. Natychmiastowy sys_poweroff()
	  uciolby transmisje. Ten odstep daje stosowi czas na nadanie.

source "Kconfig.zephyr"
